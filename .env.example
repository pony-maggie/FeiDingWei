DATABASE_URL="file:./dev.db"

# 默认保持确定性的本地 faux provider，方便无 key 验收和自动化测试。
# Set to "openai" to run real model calls through Pi.
FEIDINGWEI_LLM_PROVIDER="faux"

# Real OpenAI provider settings. Required only when FEIDINGWEI_LLM_PROVIDER="openai".
# OPENAI_API_KEY="sk-..."
FEIDINGWEI_LLM_MODEL="gpt-5.5"
